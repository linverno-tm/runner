# Normalise line endings so files committed from different editors and
# operating systems do not churn.
* text=auto eol=lf

# GitHub language stats should reflect the app code, not the platform
# scaffolding that `flutter create` generates. Without this, the C++ and
# Swift runners drown out Dart in the repository language bar.
android/**  linguist-generated=true
ios/**      linguist-generated=true
linux/**    linguist-generated=true
macos/**    linguist-generated=true
windows/**  linguist-generated=true
web/**      linguist-generated=true
